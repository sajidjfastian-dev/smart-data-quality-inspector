modules = ["python-3.12", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["cacert", "freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m streamlit run serve.py --server.corsAllowedOrigins \"https://${REPLIT_DEV_DOMAIN}\""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["python", "-m", "streamlit", "run", "serve.py", "--server.address=0.0.0.0", "--server.port=5000", "--server.headless=true"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
AUTH_PUBLIC_ORIGIN = "https://SmartDetectives.replit.app"
